						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"// ═══════════════════════════════════════════════════════════════",
									"// ✏️  КРОК 9.2 — Створити публікацію",
									"// ═══════════════════════════════════════════════════════════════",
									"pm.test(\"✅ 9.2 — Статус 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"✅ 9.2 — title, userId та id у відповіді коректні\", function () {",
									"    const json = pm.response.json();",
									"    ",
									"    pm.expect(json.title).to.equal(pm.collectionVariables.get(\"blogTitle\"));",
									"    ",
									"    const expectedUserId = parseInt(pm.collectionVariables.get(\"blogUserId\"), 10);",
									"    pm.expect(json.userId).to.equal(expectedUserId);",
									"    ",
									"    pm.expect(json.id).to.exist;",
									"    pm.expect(json.id).to.be.a(\"number\").and.to.be.above(0);",
									"});",
									"",
									"pm.test(\"✅ 9.2 — Збережено blogPostId\", function () {",
									"    const id = pm.response.json().id;",
									"    ",
									"    pm.collectionVariables.set(\"blogPostId\", id.toString());",
									"    console.log(\"📌 blogPostId =\", id);",
									"});",
									"// ── Захисний перехід ─────────────────────────────────────────",
									"// 6. setNextRequest-захист: якщо статус НЕ 201 — перейти до \"HW 9.7 — DELETE /posts (видалення)\"",
									"if (pm.response.code !== 201) {",
									"    console.warn(\"⚠️  Пост не створено (код \" + pm.response.code + \"). Перехід до очищення.\");",
									"    pm.execution.setNextRequest(\"HW 9.7 — DELETE /posts (видалення)\");",
									"}"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
