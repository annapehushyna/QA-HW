					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"console.log(\"🔴 Негативне тестування POST /posts — 5 невалідних кейсів\");"
								],
								"type": "text/javascript",
								"packages": {}
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"// ═══════════════════════════════════════════════════════════════",
									"// ✏️  КРОК 9.2 — 5 негативних кейсів для POST /posts",
									"// ═══════════════════════════════════════════════════════════════",
									"// Усі 5 запитів йдуть до одного ендпоінта через pm.sendRequest.",
									"// JSONPlaceholder — fake API, повертає 201 для будь-якого тіла.",
									"// У реальному API кожен кейс повинен повертати 400 або 422.",
									"const endpoint = pm.collectionVariables.get(\"baseUrl\") + \"/posts\";",
									"",
									"const negCases = [",
									"    {",
									"        label:        \"1 — Порожнє тіло {}\",",
									"        payload:      {},",
									"        fakeExpected: 201, // для JSONPlaceholder",
									"        realExpected: 400, // для реального API",
									"        note:         \"Усі обов'язкові поля відсутні\"",
									"    },",
									"    {",
									"        label:        \"2 — Відсутній title\",",
									"        payload:      { body: \"Тіло поста\", userId: 1 },",
									"        fakeExpected: 201,",
									"        realExpected: 422,",
									"        note:         \"Поле title є обов'язковим\"",
									"    },",
									"    {",
									"        label:        \"3 — Пустий title (empty string)\",",
									"        payload:      { title: \"\", body: \"Тіло поста\", userId: 1 },",
									"        fakeExpected: 201,",
									"        realExpected: 422,",
									"        note:         \"Порожній рядок не є валідним заголовком\"",
									"    },",
									"    {",
									"        label:        \"4 — userId є рядком замість числа\",",
									"        payload:      { title: \"Тест\", body: \"Тіло\", userId: \"не-число\" },",
									"        fakeExpected: 201,",
									"        realExpected: 422,",
									"        note:         \"userId повинен бути цілим числом (number)\"",
									"    },",
									"    {",
									"        label:        \"5 — userId не існує (99999)\",",
									"        payload:      { title: \"Тест\", body: \"Тіло\", userId: 99999 },",
									"        fakeExpected: 201,",
									"        realExpected: 404,",
									"        note:         \"Референційна цілісність: userId має вказувати на реального юзера\"",
									"    },",
									"];",
									"",
									"negCases.forEach(function (tc) {",
									"    pm.test(\"❌ Негативний кейс: \" + tc.label, function (done) {",
									"        pm.sendRequest({",
									"            url:    endpoint,",
									"            method: \"POST\",",
									"            header: [{ key: \"Content-Type\", value: \"application/json\" }],",
									"            body:   { mode: \"raw\", raw: JSON.stringify(tc.payload) }",
									"        }, function (err, res) {",
									"            if (err) { ",
									"                done(err); ",
									"                return; ",
									"            }",
									"            console.log(\"[\" + tc.label + \"] \" + tc.note);",
									"            console.log(\"  → Отримали: \" + res.code + \" | Реальне API поверне: \" + tc.realExpected);",
									"            ",
									"            // ПЕРЕВІРКА ДЛЯ JSONPlaceholder (щоб тести зараз були зеленими):",
									"            pm.expect(res.code).to.eql(tc.fakeExpected);",
									"            ",
									"            // ПЕРЕВІРКА ДЛЯ РЕАЛЬНОГО API (розкоментуйте, коли перейдете з фейкового сервера):",
									"            // pm.expect(res.code).to.eql(tc.realExpected);",
									"            ",
									"            pm.expect(res.code).to.be.a(\"number\"); ",
									"            done();",
									"        });",
									"    });",
									"});"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
